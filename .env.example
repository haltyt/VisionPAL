# Vision PAL ネットワーク設定 (全マシン共通テンプレ)
#
# 使い方:
#   1. このファイルをコピー: cp .env.example .env
#   2. 環境に合わせて値を編集
#   3. .env を vp_env.py と同じディレクトリ or 親ディレクトリに配置
#      (リポジトリ運用時はリポジトリルートに置く)
#   4. デプロイ先 (JetBot, Jetson, PC) には .env と vp_env.py をセットで配置
#
# 優先順位: 環境変数 > .env > 各スクリプトのフォールバック既定値

# === JetBot (Jetson Nano + MotorHAT + USB camera) ===
# mosquitto broker と MJPEG カメラサーバが動くマシン
MQTT_HOST=192.168.3.12
MQTT_PORT=1883
CAMERA_URL=http://192.168.3.12:8554/stream
CAMERA_SNAP_URL=http://192.168.3.12:8554/snap

# === Connectome-inspired neural layer ===
# Camera frames are reduced before optical flow; smaller values reduce Jetson load.
NEURAL_FRAME_WIDTH=160
NEURAL_FRAME_HEIGHT=120
NEURAL_FPS=15
NEURAL_SMOOTHING=0.55
# Seven LIF populations; 96 gives 672 simulated neurons.
NEURAL_POPULATION_SIZE=96
# Increase these values if camera shake causes false avoidance.
NEURAL_MOTION_THRESHOLD=0.28
NEURAL_LOOMING_THRESHOLD=0.24
NEURAL_ESCAPE_THRESHOLD=0.72

# === StreamDiffusion (PC, RTX 2080Ti) ===
STREAM_DIFFUSION_HOST=192.168.3.7
STREAM_DIFFUSION_PORT=8555

# === 認知エンジン (旧 Jetson ホスト OpenClaw) ===
# 今は JetBot に同居している場合は MQTT_HOST と同じ IP を入れる
COGNITION_HOST=192.168.3.5
COGNITION_PORT=1883
JETSON_HOST=192.168.3.5

# === 3DGS sharp server ===
SHARP_SERVER_URL=http://192.168.3.5:8080

# === MQTT topics (通常は変更不要) ===
MQTT_MOVE_TOPIC=vision_pal/move
MQTT_STATUS_TOPIC=vision_pal/status
