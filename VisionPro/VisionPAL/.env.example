# Vision PAL アプリ設定 (このファイルをコピーして .env を作成)
#
# 使い方:
#   1. このファイルを `.env` という名前でコピー
#   2. Xcode で File → Add Files... から `.env` をプロジェクトに追加
#      (Target Membership で VisionPAL にチェック)
#   3. アプリ起動時に Bundle から自動読み込み
#
# 優先順位: 環境変数 > .env > AppConfig.swift の既定値

# JetBot (Jetson Nano + MotorHAT + USB camera)
MQTT_HOST=192.168.3.12
MQTT_PORT=1883
CAMERA_URL=http://192.168.3.12:8554/stream

# StreamDiffusion (PC GPU, RTX 2080Ti)
STREAM_DIFFUSION_HOST=192.168.3.7
STREAM_DIFFUSION_PORT=8555

# 認知エンジン (旧 Jetson ホスト OpenClaw)
COGNITION_HOST=192.168.3.5
COGNITION_PORT=1883

# 3DGS sharp server
SHARP_SERVER_URL=http://192.168.3.5:8080
